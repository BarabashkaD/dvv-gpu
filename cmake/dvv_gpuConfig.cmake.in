@PACKAGE_INIT@

# The version, with the release-stage label of a pre-release build (applications show it, e.g. in
# --version).
set(dvv_gpu_VERSION_STRING "@dvv_gpu_VERSION_STRING@")

include(CMakeFindDependencyMacro)
find_dependency(dvv_base @dvv_base_MIN_VERSION@)
find_dependency(dvv_platform @dvv_platform_MIN_VERSION@)
# The pinned Vulkan-Headers package only, never CMake's FindVulkan module; the consumer's own
# setting is restored afterwards (this file runs in the consumer's scope).
set(_dvv_gpu_disable_vulkan "${CMAKE_DISABLE_FIND_PACKAGE_Vulkan}")
set(CMAKE_DISABLE_FIND_PACKAGE_Vulkan ON)
find_dependency(VulkanHeaders 1.4.365 EXACT CONFIG)
set(CMAKE_DISABLE_FIND_PACKAGE_Vulkan "${_dvv_gpu_disable_vulkan}")
unset(_dvv_gpu_disable_vulkan)

include("${CMAKE_CURRENT_LIST_DIR}/dvv_gpuTargets.cmake")
# dvv_add_shaders(); it needs the pinned slangc in CMAKE_PREFIX_PATH when it is called.
include("${CMAKE_CURRENT_LIST_DIR}/DvvShaders.cmake")

# The `text` component, dvv::gpu_text: only find_package(dvv_gpu COMPONENTS text) loads it, so the
# users of dvv::gpu alone need none of the OS text libraries. It is a static library: on Linux its
# users link its Pango too (pangocairo >= 1.44 through pkg-config).
set(dvv_gpu_text_FOUND FALSE)
if("text" IN_LIST dvv_gpu_FIND_COMPONENTS)
    set(_dvv_gpu_text_ready TRUE)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/dvv_gpuTextTargets.cmake")
        # Built in-tree without pangocairo.
        set(_dvv_gpu_text_ready FALSE)
        if(dvv_gpu_FIND_REQUIRED_text)
            set(dvv_gpu_NOT_FOUND_MESSAGE
                "this dvv_gpu install has no text component (built without pangocairo)")
        endif()
    elseif(NOT APPLE AND NOT WIN32)
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(DVV_GPU_PANGOCAIRO QUIET IMPORTED_TARGET "pangocairo>=1.44")
        endif()
        if(NOT DVV_GPU_PANGOCAIRO_FOUND)
            set(_dvv_gpu_text_ready FALSE)
            if(dvv_gpu_FIND_REQUIRED_text)
                set(dvv_gpu_NOT_FOUND_MESSAGE
                    "dvv_gpu's text component needs pangocairo >= 1.44 (pkg-config) on Linux")
            endif()
        endif()
    endif()
    if(_dvv_gpu_text_ready)
        include("${CMAKE_CURRENT_LIST_DIR}/dvv_gpuTextTargets.cmake")
        set(dvv_gpu_text_FOUND TRUE)
    endif()
    unset(_dvv_gpu_text_ready)
endif()

check_required_components(dvv_gpu)
